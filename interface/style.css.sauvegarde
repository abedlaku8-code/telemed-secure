/* =========================================================
   TELEMED SECURE
   Feuille de style principale
   Projet académique de télémédecine sécurisée
   ========================================================= */


/* ---------------------------------------------------------
   1. VARIABLES
   --------------------------------------------------------- */

:root {
    --couleur-principale: #0f766e;
    --couleur-principale-foncee: #115e59;
    --couleur-secondaire: #0ea5e9;

    --couleur-fond: #f4f8fa;
    --couleur-surface: #ffffff;

    --couleur-texte: #172033;
    --couleur-texte-secondaire: #64748b;
    --couleur-bordure: #dbe5ea;

    --couleur-succes: #15803d;
    --couleur-succes-fond: #ecfdf3;

    --couleur-erreur: #b91c1c;
    --couleur-erreur-fond: #fef2f2;

    --couleur-info: #0369a1;
    --couleur-info-fond: #eff6ff;

    --ombre-legere:
        0 8px 25px rgba(15, 23, 42, 0.06);

    --ombre-carte:
        0 12px 35px rgba(15, 23, 42, 0.08);

    --rayon-petit: 8px;
    --rayon-moyen: 14px;
    --rayon-grand: 20px;
}


/* ---------------------------------------------------------
   2. RESET
   --------------------------------------------------------- */

* {
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {
    margin: 0;
    padding: 0;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    color: var(--couleur-texte);

    background:
        var(--couleur-fond);

    line-height: 1.6;
}


button,
input {
    font-family: inherit;
}


button {
    cursor: pointer;
}


a {
    color: inherit;
}


/* ---------------------------------------------------------
   3. PAGE DE CONNEXION
   --------------------------------------------------------- */

.page-connexion {
    min-height: 100vh;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 30px 20px;

    background:
        linear-gradient(
            135deg,
            #ecfeff 0%,
            #f8fafc 50%,
            #eff6ff 100%
        );
}


.conteneur-connexion {
    width: 100%;
    max-width: 1080px;

    display: grid;
    grid-template-columns: 1fr 1fr;

    background: var(--couleur-surface);

    border: 1px solid var(--couleur-bordure);

    border-radius: var(--rayon-grand);

    box-shadow: var(--ombre-carte);

    overflow: hidden;
}


.presentation-connexion {
    padding: 55px;

    color: white;

    background:
        linear-gradient(
            145deg,
            #115e59,
            #0f766e,
            #0369a1
        );

    display: flex;
    flex-direction: column;
    justify-content: center;
}


.presentation-connexion h1 {
    margin: 20px 0 12px;

    font-size: 42px;

    line-height: 1.15;
}


.presentation-connexion p {
    margin: 0;

    color: rgba(255, 255, 255, 0.88);

    font-size: 17px;
}


.logo-connexion {
    display: flex;
    align-items: center;
    gap: 14px;
}


.icone-logo-grand {
    width: 54px;
    height: 54px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 14px;

    background: rgba(255, 255, 255, 0.16);

    font-size: 30px;
}


.elements-securite {
    display: grid;
    gap: 12px;

    margin-top: 35px;
}


.element-securite {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 13px 15px;

    border-radius: 10px;

    background: rgba(255, 255, 255, 0.10);
}


.element-securite span:first-child {
    font-size: 20px;
}


.formulaire-connexion {
    padding: 55px;

    display: flex;
    flex-direction: column;

    justify-content: center;
}


.sur-titre {
    display: inline-block;

    margin-bottom: 8px;

    color: var(--couleur-principale);

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 1.2px;
}


.formulaire-connexion h2 {
    margin: 0 0 8px;

    font-size: 30px;
}


.description-formulaire {
    margin: 0 0 30px;

    color: var(--couleur-texte-secondaire);
}


.groupe-formulaire {
    margin-bottom: 20px;
}


.groupe-formulaire label {
    display: block;

    margin-bottom: 8px;

    font-weight: 600;

    font-size: 14px;
}


.groupe-formulaire input {
    width: 100%;

    padding: 13px 14px;

    border:
        1px solid
        var(--couleur-bordure);

    border-radius: 10px;

    background: #fff;

    color: var(--couleur-texte);

    font-size: 15px;

    outline: none;

    transition:
        border-color 0.2s,
        box-shadow 0.2s;
}


.groupe-formulaire input:focus {
    border-color:
        var(--couleur-principale);

    box-shadow:
        0 0 0 3px
        rgba(15, 118, 110, 0.12);
}


.ligne-mot-de-passe {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 8px;
}


.ligne-mot-de-passe label {
    margin: 0;
}


.lien-secondaire {
    color: var(--couleur-principale);

    font-size: 13px;

    text-decoration: none;

    font-weight: 600;
}


.lien-secondaire:hover {
    text-decoration: underline;
}


.bouton-principal {
    width: 100%;

    padding: 13px 20px;

    border: none;

    border-radius: 10px;

    background:
        linear-gradient(
            135deg,
            var(--couleur-principale),
            var(--couleur-principale-foncee)
        );

    color: white;

    font-size: 15px;

    font-weight: 700;

    transition:
        transform 0.15s,
        opacity 0.15s,
        box-shadow 0.15s;
}


.bouton-principal:hover {
    transform: translateY(-1px);

    box-shadow:
        0 8px 18px
        rgba(15, 118, 110, 0.22);
}


.bouton-principal:disabled {
    opacity: 0.55;

    cursor: not-allowed;

    transform: none;

    box-shadow: none;
}


.note-securite {
    margin-top: 22px;

    padding: 13px 15px;

    border-radius: 10px;

    background:
        var(--couleur-info-fond);

    color: var(--couleur-info);

    font-size: 13px;
}


/* ---------------------------------------------------------
   4. MESSAGES
   --------------------------------------------------------- */

.message {
    margin: 16px 0 0;

    padding: 11px 14px;

    border-radius: 9px;

    font-size: 14px;

    display: none;
}


.message:not(:empty) {
    display: block;
}


.message.succes {
    color: var(--couleur-succes);

    background:
        var(--couleur-succes-fond);

    border:
        1px solid
        #bbf7d0;
}


.message.erreur {
    color: var(--couleur-erreur);

    background:
        var(--couleur-erreur-fond);

    border:
        1px solid
        #fecaca;
}


.message.chargement {
    color: var(--couleur-info);

    background:
        var(--couleur-info-fond);

    border:
        1px solid
        #bfdbfe;
}


.message.information {
    color: var(--couleur-info);

    background:
        var(--couleur-info-fond);

    border:
        1px solid
        #bfdbfe;
}


/* ---------------------------------------------------------
   5. MFA
   --------------------------------------------------------- */

.page-mfa {
    min-height: 100vh;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 30px 20px;

    background:
        linear-gradient(
            135deg,
            #f0fdfa,
            #f8fafc,
            #eff6ff
        );
}


.carte-mfa {
    width: 100%;
    max-width: 780px;

    padding: 40px;

    background: white;

    border:
        1px solid
        var(--couleur-bordure);

    border-radius: var(--rayon-grand);

    box-shadow: var(--ombre-carte);
}


.en-tete-mfa {
    margin-bottom: 28px;

    text-align: center;
}


.icone-mfa {
    width: 60px;
    height: 60px;

    margin: 0 auto 16px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 16px;

    background: #ecfeff;

    color: var(--couleur-principale);

    font-size: 28px;
}


.en-tete-mfa h1 {
    margin: 0 0 8px;

    font-size: 30px;
}


.en-tete-mfa p {
    margin: 0;

    color: var(--couleur-texte-secondaire);
}


.methodes-mfa {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 14px;

    margin-bottom: 25px;
}


.methode-mfa {
    min-height: 125px;

    padding: 18px;

    text-align: left;

    border:
        1px solid
        var(--couleur-bordure);

    border-radius: 13px;

    background: white;

    color: var(--couleur-texte);

    transition:
        border-color 0.2s,
        box-shadow 0.2s;
}


.methode-mfa:hover:not(:disabled) {
    border-color:
        var(--couleur-principale);
}


.methode-mfa.active {
    border:
        2px solid
        var(--couleur-principale);

    background: #f0fdfa;

    box-shadow:
        0 5px 16px
        rgba(15, 118, 110, 0.08);
}


.methode-mfa:disabled {
    opacity: 0.58;

    cursor: not-allowed;
}


.methode-mfa .icone-methode {
    font-size: 23px;

    margin-bottom: 9px;
}


.methode-mfa strong {
    display: block;

    margin-bottom: 3px;
}


.methode-mfa small {
    color: var(--couleur-texte-secondaire);
}


.badge-bientot {
    display: inline-block;

    margin-top: 8px;

    padding: 3px 7px;

    border-radius: 20px;

    background: #f1f5f9;

    color: #64748b;

    font-size: 11px;

    font-weight: 700;
}


.formulaire-mfa {
    max-width: 420px;

    margin: 0 auto;
}


.formulaire-mfa label {
    display: block;

    margin-bottom: 8px;

    font-weight: 600;
}


.formulaire-mfa input {
    width: 100%;

    padding: 15px;

    border:
        1px solid
        var(--couleur-bordure);

    border-radius: 10px;

    font-size: 22px;

    letter-spacing: 7px;

    text-align: center;

    outline: none;
}


.formulaire-mfa input:focus {
    border-color:
        var(--couleur-principale);

    box-shadow:
        0 0 0 3px
        rgba(15, 118, 110, 0.12);
}


.retour-connexion {
    display: block;

    margin-top: 20px;

    text-align: center;

    color: var(--couleur-principale);

    text-decoration: none;

    font-size: 14px;

    font-weight: 600;
}


/* ---------------------------------------------------------
   6. PAGES INTERNES
   --------------------------------------------------------- */

.page-interne {
    min-height: 100vh;

    background:
        var(--couleur-fond);
}


.barre-navigation {
    min-height: 72px;

    padding:
        0 32px;

    display: flex;
    align-items: center;

    gap: 30px;

    background: white;

    border-bottom:
        1px solid
        var(--couleur-bordure);

    position: sticky;

    top: 0;

    z-index: 100;
}


.marque {
    display: flex;
    align-items: center;

    gap: 10px;

    min-width: 230px;
}


.icone-logo {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background:
        var(--couleur-principale);

    color: white;

    font-size: 20px;
}


.marque strong {
    display: block;

    font-size: 15px;
}


.marque span {
    display: block;

    color: var(--couleur-texte-secondaire);

    font-size: 11px;
}


.navigation-principale {
    display: flex;

    align-items: center;

    gap: 5px;

    flex: 1;
}


.navigation-principale a {
    padding: 9px 12px;

    border-radius: 8px;

    color: var(--couleur-texte-secondaire);

    font-size: 13px;

    text-decoration: none;

    font-weight: 600;
}


.navigation-principale a:hover,
.navigation-principale a.actif {
    background: #f0fdfa;

    color: var(--couleur-principale);
}


.bouton-deconnexion {
    padding: 9px 14px;

    border:
        1px solid
        #fecaca;

    border-radius: 8px;

    background: white;

    color: var(--couleur-erreur);

    font-size: 13px;

    font-weight: 700;
}


.bouton-deconnexion:hover {
    background:
        var(--couleur-erreur-fond);
}


/* ---------------------------------------------------------
   7. CONTENEUR DES PAGES
   --------------------------------------------------------- */

.conteneur-page {
    width: min(
        1180px,
        calc(100% - 40px)
    );

    margin: 0 auto;

    padding: 40px 0 60px;
}


.en-tete-page {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 28px;
}


.en-tete-page h1 {
    margin: 0 0 6px;

    font-size: 34px;

    line-height: 1.2;
}


.en-tete-page p {
    margin: 0;

    color: var(--couleur-texte-secondaire);
}


.badge-securite,
.badge-rbac,
.badge-role {
    display: inline-flex;

    align-items: center;

    padding: 7px 11px;

    border-radius: 20px;

    font-size: 12px;

    font-weight: 700;

    white-space: nowrap;
}


.badge-securite,
.badge-rbac {
    color: var(--couleur-principale);

    background: #ccfbf1;
}


.badge-role {
    color: #475569;

    background: #f1f5f9;
}


.badge-role.role-patient {
    color: #0369a1;

    background: #e0f2fe;
}


.badge-role.role-medecin {
    color: #0f766e;

    background: #ccfbf1;
}


.badge-role.role-admin {
    color: #7c3aed;

    background: #ede9fe;
}


/* ---------------------------------------------------------
   8. TABLEAU DE BORD
   --------------------------------------------------------- */

.banniere-dashboard {
    margin-bottom: 25px;

    padding: 25px;

    background: white;

    border:
        1px solid
        var(--couleur-bordure);

    border-radius: var(--rayon-moyen);

    box-shadow: var(--ombre-legere);
}


.banniere-dashboard .ligne-role {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;
}


.banniere-dashboard h2 {
    margin: 0 0 5px;

    font-size: 22px;
}


.banniere-dashboard p {
    margin: 0;

    color: var(--couleur-texte-secondaire);
}


.grille-cartes {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 18px;
}


.carte-dashboard {
    padding: 24px;

    background: white;

    border:
        1px solid
        var(--couleur-bordure);

    border-radius: var(--rayon-moyen);

    box-shadow: var(--ombre-legere);

    transition:
        transform 0.15s,
        box-shadow 0.15s;
}


.carte-dashboard:hover {
    transform: translateY(-2px);

    box-shadow: var(--ombre-carte);
}


.icone-carte {
    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 15px;

    border-radius: 11px;

    background: #f0fdfa;

    color: var(--couleur-principale);

    font-size: 22px;
}


.carte-dashboard h3 {
    margin: 0 0 6px;

    font-size: 18px;
}


.carte-dashboard p {
    margin: 0;

    color: var(--couleur-texte-secondaire);

    font-size: 14px;
}


.lien-carte {
    display: inline-block;

    margin-top: 17px;

    color: var(--couleur-principale);

    font-size: 13px;

    font-weight: 700;

    text-decoration: none;
}


.grille-indicateurs {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 14px;

    margin-top: 25px;
}


.indicateur-securite {
    padding: 17px;

    background: white;

    border:
        1px solid
        var(--couleur-bordure);

    border-radius: 12px;
}


.indicateur-securite strong {
    display: block;

    margin-bottom: 3px;

    font-size: 14px;
}


.indicateur-securite span {
    color: var(--couleur-succes);

    font-size: 12px;

    font-weight: 700;
}


/* ---------------------------------------------------------
   9. DOSSIERS MÉDICAUX
   --------------------------------------------------------- */

.carte-dossier {
    background: white;

    border:
        1px solid
        var(--couleur-bordure);

    border-radius: var(--rayon-moyen);

    box-shadow: var(--ombre-legere);

    overflow: hidden;
}


.entete-dossier {
    padding: 24px;

    border-bottom:
        1px solid
        var(--couleur-bordure);

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;
}


.identite-patient {
    display: flex;

    align-items: center;

    gap: 15px;
}


.avatar-patient {
    width: 52px;
    height: 52px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #e0f2fe;

    color: #0369a1;

    font-weight: 800;
}


.identite-patient h2 {
    margin: 0;

    font-size: 20px;
}


.identite-patient p {
    margin: 2px 0 0;

    color: var(--couleur-texte-secondaire);

    font-size: 13px;
}


.zone-protection {
    padding: 18px 24px;

    background: #f0fdfa;

    border-bottom:
        1px solid
        #ccfbf1;

    color: #115e59;

    font-size: 13px;
}


.actions-dossier {
    padding: 20px 24px;
}


.actions-dossier .bouton-principal {
    width: auto;

    min-width: 230px;
}


.grille-informations-dossier {
    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 15px;

    padding: 0 24px 25px;
}


.information-dossier {
    padding: 18px;

    background: #f8fafc;

    border:
        1px solid
        var(--couleur-bordure);

    border-radius: 11px;
}


.information-dossier:last-child {
    grid-column: 1 / -1;
}


.titre-information {
    display: block;

    margin-bottom: 7px;

    color: var(--couleur-texte-secondaire);

    font-size: 11px;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: 0.7px;
}


.valeur-information {
    margin: 0;

    color: var(--couleur-texte);

    font-size: 14px;
}


.note-tracabilite {
    margin-top: 20px;

    padding: 13px 16px;

    border-radius: 10px;

    background: #eff6ff;

    color: #0369a1;

    font-size: 13px;
}


/* ---------------------------------------------------------
   10. ADMINISTRATION / RBAC
   --------------------------------------------------------- */

.carte-administration {
    padding: 28px;

    background: white;

    border:
        1px solid
        var(--couleur-bordure);

    border-radius: var(--rayon-moyen);

    box-shadow: var(--ombre-legere);
}


.entete-carte {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 24px;
}


.entete-carte h2 {
    margin: 0 0 5px;

    font-size: 21px;
}


.entete-carte p {
    margin: 0;

    color: var(--couleur-texte-secondaire);

    font-size: 14px;
}


.bloc-rbac {
    display: flex;

    align-items: flex-start;

    gap: 15px;

    padding: 18px;

    margin-bottom: 20px;

    border-radius: 12px;

    background: #f8fafc;
}


.icone-rbac {
    width: 44px;
    height: 44px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 11px;

    background: #ede9fe;

    color: #7c3aed;
}


.bloc-rbac h3 {
    margin: 0 0 4px;

    font-size: 15px;
}


.bloc-rbac p {
    margin: 0;

    color: var(--couleur-texte-secondaire);

    font-size: 13px;
}


.resultat-rbac {
    margin-top: 18px;
}


.resultat-autorise,
.resultat-refuse {
    display: flex;

    align-items: flex-start;

    gap: 13px;

    padding: 18px;

    border-radius: 11px;
}


.resultat-autorise {
    color: var(--couleur-succes);

    background:
        var(--couleur-succes-fond);

    border:
        1px solid
        #bbf7d0;
}


.resultat-refuse {
    color: var(--couleur-erreur);

    background:
        var(--couleur-erreur-fond);

    border:
        1px solid
        #fecaca;
}


.icone-resultat {
    width: 32px;
    height: 32px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.7);

    font-size: 18px;

    font-weight: 800;
}


.resultat-autorise h3,
.resultat-refuse h3 {
    margin: 0 0 4px;

    font-size: 15px;
}


.resultat-autorise p,
.resultat-refuse p {
    margin: 0;

    font-size: 13px;
}


.grille-securite {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 15px;

    margin-top: 20px;
}


.petite-carte-securite {
    display: flex;

    align-items: flex-start;

    gap: 12px;

    padding: 18px;

    background: white;

    border:
        1px solid
        var(--couleur-bordure);

    border-radius: 12px;
}


.petite-carte-securite > span {
    font-size: 21px;
}


.petite-carte-securite strong {
    display: block;

    margin-bottom: 3px;

    font-size: 14px;
}


.petite-carte-securite p {
    margin: 0;

    color: var(--couleur-texte-secondaire);

    font-size: 12px;
}


/* ---------------------------------------------------------
   11. JOURNAL D'AUDIT
   --------------------------------------------------------- */

.carte-audit {
    background: white;

    border:
        1px solid
        var(--couleur-bordure);

    border-radius: var(--rayon-moyen);

    box-shadow: var(--ombre-legere);

    overflow: hidden;
}


.entete-audit {
    padding: 24px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    border-bottom:
        1px solid
        var(--couleur-bordure);
}


.resume-audit {
    color: var(--couleur-texte-secondaire);

    font-size: 13px;
}


.zone-tableau {
    width: 100%;

    overflow-x: auto;
}


.tableau-audit {
    width: 100%;

    min-width: 800px;

    border-collapse: collapse;
}


.tableau-audit th,
.tableau-audit td {
    padding: 13px 15px;

    text-align: left;

    border-bottom:
        1px solid
        #edf2f5;

    font-size: 13px;
}


.tableau-audit th {
    background: #f8fafc;

    color: #475569;

    font-size: 11px;

    text-transform: uppercase;

    letter-spacing: 0.5px;
}


.tableau-audit tbody tr:hover {
    background: #f8fafc;
}


.tableau-audit td:first-child {
    color: var(--couleur-principale);

    font-weight: 700;
}


.note-audit {
    margin-top: 18px;

    padding: 13px 16px;

    border-radius: 10px;

    background: #f0fdfa;

    color: #115e59;

    font-size: 13px;
}


/* ---------------------------------------------------------
   12. PIED DE PAGE
   --------------------------------------------------------- */

.pied-page {
    width: min(
        1180px,
        calc(100% - 40px)
    );

    margin: 0 auto;

    padding: 20px 0 30px;

    display: flex;

    justify-content: space-between;

    gap: 20px;

    color: var(--couleur-texte-secondaire);

    font-size: 12px;
}


.pied-page p {
    margin: 0;
}


.pied-page span {
    font-weight: 600;
}


/* ---------------------------------------------------------
   13. RESPONSIVE — TABLETTES
   --------------------------------------------------------- */

@media (max-width: 900px) {

    .conteneur-connexion {
        grid-template-columns: 1fr;
    }


    .presentation-connexion {
        padding: 35px;
    }


    .formulaire-connexion {
        padding: 35px;
    }


    .methodes-mfa {
        grid-template-columns: 1fr;
    }


    .grille-cartes {
        grid-template-columns:
            repeat(2, 1fr);
    }


    .grille-indicateurs {
        grid-template-columns:
            repeat(2, 1fr);
    }


    .grille-securite {
        grid-template-columns: 1fr;
    }


    .barre-navigation {
        flex-wrap: wrap;

        padding: 15px 20px;

        gap: 12px;
    }


    .marque {
        min-width: auto;
    }


    .navigation-principale {
        order: 3;

        width: 100%;

        overflow-x: auto;
    }

}


/* ---------------------------------------------------------
   14. RESPONSIVE — TÉLÉPHONES
   --------------------------------------------------------- */

@media (max-width: 600px) {

    .page-connexion,
    .page-mfa {
        padding: 15px;
    }


    .presentation-connexion {
        padding: 30px 25px;
    }


    .presentation-connexion h1 {
        font-size: 32px;
    }


    .formulaire-connexion {
        padding: 30px 25px;
    }


    .carte-mfa {
        padding: 25px 20px;
    }


    .en-tete-mfa h1 {
        font-size: 25px;
    }


    .conteneur-page {
        width:
            calc(100% - 30px);

        padding-top: 25px;
    }


    .en-tete-page {
        flex-direction: column;
    }


    .en-tete-page h1 {
        font-size: 28px;
    }


    .grille-cartes,
    .grille-indicateurs,
    .grille-informations-dossier {
        grid-template-columns: 1fr;
    }


    .information-dossier:last-child {
        grid-column: auto;
    }


    .entete-dossier,
    .entete-carte,
    .entete-audit {
        flex-direction: column;

        align-items: flex-start;
    }


    .actions-dossier .bouton-principal {
        width: 100%;
    }


    .bouton-deconnexion {
        margin-left: auto;
    }


    .pied-page {
        width:
            calc(100% - 30px);

        flex-direction: column;
    }

}